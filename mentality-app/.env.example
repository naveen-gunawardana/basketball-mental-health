# Gameday — copy to .env and fill in.
#
# These point at the SAME Supabase project the website uses, which is what lets
# an athlete sign in with the account they already have. Both values are safe
# in a client bundle: the anon key is gated by row-level security.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the Next.js app is deployed. The mobile app calls /api/app/v1/* here
# for push, transcription, the safety scan, and insights.
EXPO_PUBLIC_API_BASE_URL=https://mentalitysports.org

# From `eas init`. Needed for push tokens in a build.
EAS_PROJECT_ID=
